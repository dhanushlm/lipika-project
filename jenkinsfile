pipeline {
    agent { label 'k8s-agent' }

    parameters {
        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'qa', 'preprod'],
            description: 'Select environment to deploy'
        )
    }

    environment {
        DOCKERHUB_USER = 'dhanushlm'
        DOCKERHUB_PASS = credentials('dockerhub-credentials')
        IMAGE_NAME = 'devops'
        IMAGE_TAG = "v${BUILD_NUMBER}"
        KUBECONFIG_CRED = credentials('k8s-token')
        GIT_BRANCH = 'master'
    }

    triggers {
        // Webhook trigger - automatically triggers for dev when code is pushed to master
        githubPush()
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo "Cloning code from GitHub branch: ${env.GIT_BRANCH}"
                git branch: env.GIT_BRANCH, url: 'https://github.com/dhanushlm/lipika-project.git'
            }
        }

        stage('Maven Build & Test') {
            steps {
                container('maven') {
                    echo "Running Maven build and tests..."
                    sh 'mvn clean package -DskipTests=false'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image..."
                sh """
                    docker build -t ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} .
                """
            }
        }

        stage('Push Docker Image') {
            steps {
                echo "Pushing image to DockerHub..."
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                    sh "docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy with Helm') {
            when {
                anyOf {
                    // Auto-deploy only if triggered by GitHub webhook (for dev)
                    expression { 
                        currentBuild.rawBuild.getCause(hudson.triggers.SCMTrigger.SCMTriggerCause) != null && params.DEPLOY_ENV == 'dev' 
                    }
                    // Or manual trigger for QA/preprod
                    expression { 
                        currentBuild.rawBuild.getCause(hudson.model.Cause$UserIdCause) != null 
                    }
                }
            }
            steps {
                echo "Deploying to ${params.DEPLOY_ENV} namespace using Helm..."

                withCredentials([file(credentialsId: 'k8s-token', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                        export KUBECONFIG=$KUBECONFIG_FILE
                        helm upgrade --install auth-service ./auth-service \
                            --namespace ${DEPLOY_ENV} \
                            --set image.repository=${DOCKERHUB_USER}/${IMAGE_NAME} \
                            --set image.tag=${IMAGE_TAG}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Build #${BUILD_NUMBER} succeeded for ${params.DEPLOY_ENV} environment!"
        }
        failure {
            echo "❌ Build failed. Check logs for details."
        }
    }
}
