pipeline {
    agent { label 'k8s-agent' }  // Or your configured label for K8s pod agent

    parameters {
        choice(name: 'ENV', choices: ['dev', 'qa', 'preprod'], description: 'Choose the environment to deploy')
    }

    environment {
        DOCKERHUB_USER = 'dhanushlm'
        IMAGE_NAME = 'devops'
        IMAGE_TAG = "v${env.BUILD_NUMBER}"
        KUBE_CONFIG = credentials('kubeconfig-cred') // Jenkins credential (kubeconfig file)
        DOCKERHUB_CREDS = credentials('dockerhub-credentials')
    }

    triggers {
        // Auto-trigger for dev environment only
        githubPush()
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo "Cloning repository..."
                git branch: 'master', url: 'https://github.com/dhanushlm/lipika-project.git'
            }
        }

        stage('Build Maven Artifact') {
            steps {
                echo "Building the JAR file..."
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image..."
                sh "docker build -t ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Push Docker Image to DockerHub') {
            steps {
                echo "Pushing Docker image..."
                sh """
                    echo ${DOCKERHUB_CREDS_PSW} | docker login -u ${DOCKERHUB_CREDS_USR} --password-stdin
                    docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy via Helm') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-cred', variable: 'KUBECONFIG')]) {
                    script {
                        def valuesFile = "auth-service/helm/auth-service/values-${params.ENV}.yaml"

                        echo "Deploying ${params.ENV} environment using Helm..."
                        sh """
                            helm upgrade --install auth-service-${params.ENV} ./auth-service/helm/auth-service \
                                --namespace ${params.ENV} \
                                -f ${valuesFile} \
                                --set image.repository=${DOCKERHUB_USER}/${IMAGE_NAME} \
                                --set image.tag=${IMAGE_TAG}
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Successfully deployed ${params.ENV} environment (Image: ${IMAGE_TAG})"
        }
        failure {
            echo "❌ Build or deployment failed. Check logs."
        }
    }
}
