pipeline {
    agent { label 'jenkins-agent' }   // uses your pre-configured pod template

    parameters {
        choice(name: 'ENV', choices: ['dev', 'qa', 'preprod'], description: 'Select environment to deploy')
    }

    environment {
        DOCKERHUB_USER = 'dhanushlm'
        IMAGE_NAME = 'auth-service'
        GIT_COMMIT_SHORT = "${env.GIT_COMMIT?.take(7) ?: 'local'}"
        IMAGE_TAG = "${GIT_COMMIT_SHORT}-${env.BUILD_NUMBER}"
        K8S_NAMESPACE = "${params.ENV}"
    }

    triggers {
        // auto trigger only for dev
        githubPush() // works if webhook is configured
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo "Cloning repository..."
                git branch: 'master', url: 'https://github.com/dhanushlm/lipika-project.git'
            }
        }

        stage('Build Maven Artifact') {
            steps {
                echo "Building JAR file..."
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image..."
                sh "docker build -t ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }

        stage('Push Docker Image to DockerHub') {
            steps {
                echo "Pushing Docker image..."
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                    sh "docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Helm Deploy') {
            steps {
                echo "Deploying using Helm to ${K8S_NAMESPACE} environment..."
                sh """
                helm upgrade --install ${IMAGE_NAME}-${K8S_NAMESPACE} ./helm/${IMAGE_NAME} \
                  --set image.repository=${DOCKERHUB_USER}/${IMAGE_NAME} \
                  --set image.tag=${IMAGE_TAG} \
                  --namespace ${K8S_NAMESPACE} \
                  --create-namespace
                """
            }
        }
    }

    post {
        success {
            echo "✅ Build #${env.BUILD_NUMBER} for ${IMAGE_NAME} deployed successfully to ${K8S_NAMESPACE}!"
        }
        failure {
            echo "❌ Build failed. Check logs above."
        }
    }
}
